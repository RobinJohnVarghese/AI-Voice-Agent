# Copy to .env and adjust. All values are optional.
# LLM: qwen2.5:1.5b (faster) | qwen2.5:3b (default) | qwen2.5:7b (better, ~5 GB RAM)
LLM_MODEL=qwen2.5:3b
# Speech recognition: tiny | base | small | medium
WHISPER_MODEL=small
LLM_CTX=2048
LLM_KEEP_ALIVE=30m
HISTORY_TURNS=6
MAX_LOADED_VOICES=2
OLLAMA_URL=http://127.0.0.1:11434
# MODELS_DIR=./models
# DATA_DIR=./data
